# Copy to .env and fill in. Never commit .env.

# ── Server-only (used by src/app/api/*+api.ts) ───────────────────────────────
# Neon Console → your project → Connect → pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon Console → Auth → Configuration → Auth URL
NEON_AUTH_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
# Origin sent to Neon Auth; must be in Auth → Domains in production (localhost is pre-approved)
NEON_AUTH_ORIGIN=http://localhost:8081
# Pinata → API Keys → New key (scope: org:files:write) → JWT
PINATA_JWT=
# Optional: Pinata group to file uploads under
PINATA_GROUP_ID=

# ── Client (bundled into the app — no secrets here) ──────────────────────────
# Production API origin (e.g. your EAS Hosting URL). Leave empty in development.
EXPO_PUBLIC_API_URL=
# Comma-separated IPFS gateways tried first (e.g. your Pinata dedicated gateway)
EXPO_PUBLIC_IPFS_GATEWAYS=
